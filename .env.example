# .env.example — ШАБЛОН переменных окружения для docker-compose
# Скопируйте в .env и заполните. НЕ коммитьте .env с реальными значениями.
#
# ВНИМАНИЕ: текущая версия кода (3.2.15) читает настройки ТОЛЬКО из config.toml.
# Чтение секретов из ENV — это доработка P0.3 (см. docs/IMPROVEMENT_ROADMAP.md).
# Пока доработка не внесена, эти переменные служат для:
#   1) хранения секретов вне config.toml до их подстановки на сервере;
#   2) задания TZ и параметров docker-compose.
#
# Часовой пояс контейнера
TZ=Europe/Moscow

# --- Секреты (использовать после внедрения чтения ENV или подставлять в config.toml на сервере) ---
AVITO_TG_TOKEN=
AVITO_TG_CHAT_ID=
AVITO_VK_TOKEN=
AVITO_VK_USER_ID=
AVITO_COOKIES_API_KEY=
AVITO_PROXY_STRING=
AVITO_PROXY_CHANGE_URL=
AVITO_PROXY_NOTIFIER=
